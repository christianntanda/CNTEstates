  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and display preferences scoped strictly to the owning user or platform admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted platform admin lookup registry. Client writes strictly forbidden."
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Tenant organization master workspace documents."
    },
    "/organizations/{orgId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/OrganizationMember" },
      "description": "Role-based membership subcollection for an organization."
    },
    "/organizations/{orgId}/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Real estate properties owned by the parent organization."
    },
    "/organizations/{orgId}/units/{unitId}": {
      "schema": { "$ref": "#/entities/Unit" },
      "description": "Rental units within properties of the parent organization."
    },
    "/organizations/{orgId}/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/ServiceTicket" },
      "description": "Maintenance and service tickets scoped to the parent organization."
    },
    "/organizations/{orgId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/SubscriptionInvoice" },
      "description": "Subscription billing invoices scoped to the parent organization with immutable terminal states."
    },
    "/organizations/{orgId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only immutable audit trail for the parent organization."
    }
  }
}
