{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account metadata and display preferences. Strictly private to the account owner or platform admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User full display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "User verified email address (PII)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional avatar image URL."
        },
        "defaultOrganizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Primary organization ID associated with the user."
        },
        "preferredCurrency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 10,
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code for display."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "fr", "es", "pt"],
          "description": "Preferred UI locale."
        },
        "accountCategory": {
          "type": "string",
          "enum": ["org_owner", "portfolio_manager", "property_manager", "building_manager", "finance_manager", "maintenance_manager", "technician", "contractor", "security_officer", "facility_manager", "tenant", "auditor"],
          "description": "User operational role category (platform_admin is strictly out-of-band via /admins)."
        },
        "linkedProviders": {
          "type": "array",
          "description": "Linked Firebase Auth provider IDs (e.g. google.com, microsoft.com, apple.com, github.com, password). Bounded to max 10 entries."
        },
        "termsAcceptedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp recording user acceptance of CNTEstates Terms and Conditions."
        },
        "privacyAcceptedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp recording user acceptance of CNTEstates Privacy Policy."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of user document creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "defaultOrganizationId",
        "preferredCurrency",
        "preferredLanguage",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted platform administrator registry document. Managed strictly out-of-band.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Administrator email address."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when admin privileges were granted."
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant landlord or property management organization workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique organization identifier."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the organization owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Legal or trading name of the organization."
        },
        "planId": {
          "type": "string",
          "enum": ["free", "starter", "basic", "professional", "business", "enterprise"],
          "description": "Active CNTEstates subscription tier."
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["free", "trial", "active", "past_due", "payment_failed", "suspended", "cancelled", "expired", "pending_activation"],
          "description": "Subscription lifecycle status."
        },
        "operatingCountry": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Primary operating country name."
        },
        "baseCurrency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 10,
          "pattern": "^[A-Z]{3}$",
          "description": "Organization base accounting currency."
        },
        "billingCurrency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 10,
          "pattern": "^[A-Z]{3}$",
          "description": "Subscription billing currency."
        },
        "monthlySpend": {
          "type": "number",
          "description": "Current subscription spend in USD master currency."
        },
        "renewalDate": {
          "type": "string",
          "maxLength": 32,
          "description": "Next billing cycle renewal date (YYYY-MM-DD)."
        },
        "companyAddress": {
          "type": "string",
          "maxLength": 300,
          "description": "Branded legal billing address."
        },
        "companyEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Branded billing contact email."
        },
        "companyPhone": {
          "type": "string",
          "maxLength": 40,
          "description": "Branded contact phone number."
        },
        "taxRegistrationNumber": {
          "type": "string",
          "maxLength": 64,
          "description": "Statutory VAT/GST/EIN registration number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "planId",
        "subscriptionStatus",
        "operatingCountry",
        "baseCurrency",
        "billingCurrency",
        "monthlySpend",
        "renewalDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "Member role assignment within a tenant organization.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the member."
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent organization ID."
        },
        "role": {
          "type": "string",
          "enum": ["org_owner", "portfolio_manager", "property_manager", "building_manager", "finance_manager", "maintenance_manager", "technician", "contractor", "security_officer", "facility_manager", "tenant", "auditor"],
          "description": "Assigned organizational role."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the member."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of membership creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of membership update."
        }
      },
      "required": ["uid", "organizationId", "role", "displayName", "createdAt", "updatedAt"]
    },
